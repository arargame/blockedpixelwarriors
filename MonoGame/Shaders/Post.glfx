// Post-processing chain (RenderPipeline.js): bloom (UnrealBloomPass), colour grade (GradePass),
// barrel lens + fringe (LensPass), ACES filmic tone mapping and sRGB output (OutputPass).
// Full-screen triangles are drawn in clip space (a_pos.xy in -1..1).
@uniform ps vec2 Texel
@uniform ps vec2 Direction
@uniform ps float KernelRadius
@uniform ps vec4 BloomParams
@uniform ps vec4 BloomFactors
@uniform ps float BloomFactor4
@uniform ps float Exposure
@uniform ps float Saturation
@uniform ps float Contrast
@uniform ps float Vignette
@uniform ps vec2 SunPos
@uniform ps vec3 SunColor
@uniform ps float SunStrength
@uniform ps float Aspect
@uniform ps vec3 Haze
@uniform ps float HazeStrength
@uniform ps vec3 Tint
@uniform ps float Ash
@uniform ps float LensK
@uniform ps float Fringe
@uniform ps float ToneExposure
@uniform ps float Opacity
@sampler Source 0
@sampler Bloom0 1
@sampler Bloom1 2
@sampler Bloom2 3
@sampler Bloom3 4
@sampler Bloom4 5
@attribute a_pos POSITION 0
@technique Copy vs=VS ps=PsCopy
@technique Bright vs=VS ps=PsBright
@technique Blur vs=VS ps=PsBlur
@technique BlurRgba vs=VS ps=PsBlurRgba
@technique BloomBlur vs=VS ps=PsBloomBlur
@technique BloomCombine vs=VS ps=PsBloomCombine
@technique Composite vs=VS ps=PsComposite
@technique Fxaa vs=VS ps=PsFxaa
#common
varying vec2 v_uv;
#vs VS
void main()
{
    // v = 0 at the top of the render target (MonoGame texture convention).
    v_uv = vec2(a_pos.x * 0.5 + 0.5, 0.5 - a_pos.y * 0.5);
    gl_Position = vec4(a_pos.xy, 0.0, 1.0);
}

#ps PsCopy
void main()
{
    gl_FragColor = texture2D(Source, v_uv) * Opacity;
}

#ps PsBright
// Luminosity high pass (threshold, smooth width).
void main()
{
    vec4 c = texture2D(Source, v_uv);
    float l = dot(c.rgb, vec3(0.299, 0.587, 0.114));
    float a = smoothstep(BloomParams.x, BloomParams.x + BloomParams.y, l);
    gl_FragColor = vec4(c.rgb * a, 1.0);
}

#ps PsBlur
// 9-tap separable Gaussian (linear-sampling weights).
void main()
{
    vec2 o = Direction * Texel;
    vec3 c = texture2D(Source, v_uv).rgb * 0.2270270270;
    c += texture2D(Source, v_uv + o * 1.3846153846).rgb * 0.3162162162;
    c += texture2D(Source, v_uv - o * 1.3846153846).rgb * 0.3162162162;
    c += texture2D(Source, v_uv + o * 3.2307692308).rgb * 0.0702702703;
    c += texture2D(Source, v_uv - o * 3.2307692308).rgb * 0.0702702703;
    gl_FragColor = vec4(c, 1.0);
}

#ps PsBlurRgba
// Same 9-tap Gaussian on premultiplied RGBA (ForegroundBlurPass).
void main()
{
    vec2 o = Direction * Texel;
    vec4 c = texture2D(Source, v_uv) * 0.2270270270;
    c += texture2D(Source, v_uv + o * 1.3846153846) * 0.3162162162;
    c += texture2D(Source, v_uv - o * 1.3846153846) * 0.3162162162;
    c += texture2D(Source, v_uv + o * 3.2307692308) * 0.0702702703;
    c += texture2D(Source, v_uv - o * 3.2307692308) * 0.0702702703;
    gl_FragColor = c;
}

#ps PsBloomBlur
// UnrealBloomPass separable blur: KernelRadius taps per side, sigma = KernelRadius.
float gaussianPdf(float x, float sigma) { return 0.39894 * exp(-0.5 * x * x / (sigma * sigma)) / sigma; }
void main()
{
    float sigma = KernelRadius;
    float weightSum = gaussianPdf(0.0, sigma);
    vec3 sum = texture2D(Source, v_uv).rgb * weightSum;
    for (int i = 1; i < 11; i++)
    {
        float x = float(i);
        if (x >= KernelRadius) break;
        float w = gaussianPdf(x, sigma);
        vec2 off = Direction * Texel * x;
        sum += (texture2D(Source, v_uv + off).rgb + texture2D(Source, v_uv - off).rgb) * w;
        weightSum += 2.0 * w;
    }
    gl_FragColor = vec4(sum / weightSum, 1.0);
}

#ps PsBloomCombine
// UnrealBloom composite: strength * sum(lerpBloomFactor(f_i) * mip_i).
void main()
{
    vec3 c = BloomFactors.x * texture2D(Bloom0, v_uv).rgb
           + BloomFactors.y * texture2D(Bloom1, v_uv).rgb
           + BloomFactors.z * texture2D(Bloom2, v_uv).rgb
           + BloomFactors.w * texture2D(Bloom3, v_uv).rgb
           + BloomFactor4 * texture2D(Bloom4, v_uv).rgb;
    gl_FragColor = vec4(c * BloomParams.z, 1.0);
}

#ps PsComposite
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#endif
vec2 warp(vec2 ndc, float k)
{
    float s = 1.0 / (1.0 + k * (1.0 + 1.0 / (Aspect * Aspect)));
    float r2 = ndc.x * ndc.x + ndc.y * ndc.y / (Aspect * Aspect);
    return ndc * s * (1.0 + k * r2);
}

vec3 hdrAt(vec2 uv)
{
    return texture2D(Source, uv).rgb + texture2D(Bloom0, uv).rgb;
}

// GradePass: saturation, contrast, warm sun bloom, haze, vignette (+ ash for the card screen).
vec3 grade(vec3 c, vec2 uv)
{
    c *= Exposure * Tint;
    float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
    c = mix(vec3(l), c, Saturation);
    c = max((c - 0.18) * Contrast + 0.18, vec3(0.0));
    // Grade positions use Three's uv convention (v = 0 at the bottom).
    vec2 gu = vec2(uv.x, 1.0 - uv.y);
    vec2 d = (gu - SunPos) * vec2(Aspect, 1.0);
    float dist = length(d);
    c += SunColor * (exp(-dist * 2.4) * 0.8 + exp(-dist * 7.0) * 0.6) * SunStrength;
    c = mix(c, Haze * max(l, 0.6), smoothstep(0.55, 1.0, gu.y) * HazeStrength);
    vec2 v = gu - 0.5;
    c *= 1.0 - dot(v, v) * Vignette;
    float al = dot(c, vec3(0.2126, 0.7152, 0.0722));
    vec3 ash = vec3(0.92, 0.93, 0.96) * (al * 0.62 + 0.03);
    ash *= 1.0 - dot(v, v) * 1.1;
    return mix(c, ash, Ash);
}

// Three.js ACESFilmicToneMapping (Stephen Hill fit).
vec3 RRTAndODTFit(vec3 v)
{
    vec3 a = v * (v + 0.0245786) - 0.000090537;
    vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
    return a / b;
}

vec3 aces(vec3 color)
{
    color *= ToneExposure / 0.6;
    vec3 c = vec3(
        dot(color, vec3(0.59719, 0.35458, 0.04823)),
        dot(color, vec3(0.07600, 0.90834, 0.01566)),
        dot(color, vec3(0.02840, 0.13383, 0.83777)));
    c = RRTAndODTFit(c);
    vec3 o = vec3(
        dot(c, vec3(1.60475, -0.53108, -0.07367)),
        dot(c, vec3(-0.10208, 1.10813, -0.00605)),
        dot(c, vec3(-0.00327, -0.07276, 1.07602)));
    return clamp(o, 0.0, 1.0);
}

vec3 linearToSrgb(vec3 c)
{
    vec3 lo = c * 12.92;
    vec3 hi = 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055;
    return mix(lo, hi, step(vec3(0.0031308), c));
}

void main()
{
    // Barrel lens: sample the graded frame at the warped position, with a slight colour fringe.
    vec2 ndc = vec2(v_uv.x * 2.0 - 1.0, 1.0 - v_uv.y * 2.0);
    vec2 w = warp(ndc, LensK);
    vec2 g = vec2(w.x * 0.5 + 0.5, 0.5 - w.y * 0.5);
    float r2 = dot(ndc, ndc);
    vec2 off = (g - 0.5) * Fringe * r2;
#ifdef MOBILE
    // Phones: one graded sample (no colour fringe).
    vec3 c = grade(hdrAt(g), g);
#else
    vec3 c;
    c.r = grade(hdrAt(g + off), g + off).r;
    c.g = grade(hdrAt(g), g).g;
    c.b = grade(hdrAt(g - off), g - off).b;
#endif
    gl_FragColor = vec4(linearToSrgb(aces(c)), 1.0);
}

#ps PsFxaa
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#endif
// FXAA (Lottes, console variant) on the final LDR frame. MonoGame's GL backend only creates
// 8-bit MSAA render targets, so the HDR scene renders without MSAA and edges are smoothed here.
float luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }
void main()
{
    vec2 px = Texel;
    vec3 rgbNW = texture2D(Source, v_uv + vec2(-1.0, -1.0) * px).rgb;
    vec3 rgbNE = texture2D(Source, v_uv + vec2(1.0, -1.0) * px).rgb;
    vec3 rgbSW = texture2D(Source, v_uv + vec2(-1.0, 1.0) * px).rgb;
    vec3 rgbSE = texture2D(Source, v_uv + vec2(1.0, 1.0) * px).rgb;
    vec4 rgbaM = texture2D(Source, v_uv);
    float lumaNW = luma(rgbNW);
    float lumaNE = luma(rgbNE);
    float lumaSW = luma(rgbSW);
    float lumaSE = luma(rgbSE);
    float lumaM = luma(rgbaM.rgb);
    float lumaMin = min(lumaM, min(min(lumaNW, lumaNE), min(lumaSW, lumaSE)));
    float lumaMax = max(lumaM, max(max(lumaNW, lumaNE), max(lumaSW, lumaSE)));
    vec2 dir = vec2(-((lumaNW + lumaNE) - (lumaSW + lumaSE)), (lumaNW + lumaSW) - (lumaNE + lumaSE));
    float dirReduce = max((lumaNW + lumaNE + lumaSW + lumaSE) * (0.25 * (1.0 / 8.0)), 1.0 / 128.0);
    float rcpDirMin = 1.0 / (min(abs(dir.x), abs(dir.y)) + dirReduce);
    dir = clamp(dir * rcpDirMin, vec2(-8.0), vec2(8.0)) * px;
    vec3 rgbA = 0.5 * (texture2D(Source, v_uv + dir * (1.0 / 3.0 - 0.5)).rgb + texture2D(Source, v_uv + dir * (2.0 / 3.0 - 0.5)).rgb);
    vec3 rgbB = rgbA * 0.5 + 0.25 * (texture2D(Source, v_uv + dir * -0.5).rgb + texture2D(Source, v_uv + dir * 0.5).rgb);
    float lumaB = luma(rgbB);
    gl_FragColor = vec4((lumaB < lumaMin || lumaB > lumaMax) ? rgbA : rgbB, 1.0);
}
