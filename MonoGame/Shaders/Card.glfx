// Upgrade cards (UpgradeCards.js): MeshStandard/MeshPhysical surfaces lit by a key + rim light,
// an ambient light and the RoomEnvironment, tone mapped (ACES) and sRGB-encoded per fragment like
// Three's WebGLRenderer does when drawing straight to the card canvas. Extras of the card face:
// cross-fade to the whole painting (inspect mode) and a shine band sweeping across it.

@uniform vs mat4 World
@uniform vs mat4 ViewProj

@uniform ps vec4 BaseColor
@uniform ps vec3 EmissiveColor
@uniform ps vec4 MatParams
@uniform ps vec4 Flags
@uniform ps vec4 CardParams
@uniform ps vec4 CardParams2
@uniform ps vec3 KeyDir
@uniform ps vec3 KeyColor
@uniform ps vec3 RimDir
@uniform ps vec3 RimColor
@uniform ps vec3 Ambient
@uniform ps float EnvIntensity
@uniform ps vec3 CameraPos

@sampler Albedo 0
@sampler CardArt 1
@sampler EnvMap 2

@attribute a_pos POSITION 0
@attribute a_normal NORMAL 0
@attribute a_uv TEXCOORD 0
@attribute a_color COLOR 0

@technique Card vs=VsCard ps=PsCard
@technique CardGlow vs=VsCard ps=PsGlow

#common
varying vec3 v_world;
varying vec3 v_normal;
varying vec2 v_uv;

#vs VsCard
void main()
{
    vec4 world = vec4(a_pos.xyz, 1.0) * World;
    v_world = world.xyz;
    v_normal = normalize((vec4(a_normal.xyz, 0.0) * World).xyz);
    v_uv = a_uv.xy;
    gl_Position = world * ViewProj;
}

#pscommon
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#endif
#define PI 3.14159265

vec3 srgbToLinear(vec3 c) { return c * (c * (c * 0.305306011 + 0.682171111) + 0.012522878); }

vec3 linearToSrgb(vec3 c)
{
    vec3 lo = c * 12.92;
    vec3 hi = 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055;
    return mix(lo, hi, step(vec3(0.0031308), c));
}

vec3 RRTAndODTFit(vec3 v)
{
    vec3 a = v * (v + 0.0245786) - 0.000090537;
    vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
    return a / b;
}

// Three.js ACESFilmicToneMapping, exposure 1.
vec3 aces(vec3 color)
{
    color /= 0.6;
    vec3 c = vec3(
        dot(color, vec3(0.59719, 0.35458, 0.04823)),
        dot(color, vec3(0.07600, 0.90834, 0.01566)),
        dot(color, vec3(0.02840, 0.13383, 0.83777)));
    c = RRTAndODTFit(c);
    vec3 o = vec3(
        dot(c, vec3(1.60475, -0.53108, -0.07367)),
        dot(c, vec3(-0.10208, 1.10813, -0.00605)),
        dot(c, vec3(-0.00327, -0.07276, 1.07602)));
    return clamp(o, 0.0, 1.0);
}

#ps PsGlow
// Additive glow plane (MeshBasicMaterial, tone mapped): colour * texture alpha * opacity.
void main()
{
    float a = texture2D(Albedo, v_uv).a * BaseColor.a;
    gl_FragColor = vec4(linearToSrgb(aces(BaseColor.rgb)), a);
}

#ps PsCard
vec3 envLevel(vec2 uv, float level)
{
    float v = (clamp(uv.y, 0.5 / 128.0, 1.0 - 0.5 / 128.0) + level) / 8.0;
    return texture2D(EnvMap, vec2(uv.x, v)).rgb;
}

vec3 envAt(vec3 d, float rough)
{
    float l;
    if (rough <= 0.1) l = (rough - 0.0525) / 0.0475;
    else if (rough <= 0.4) l = 1.0 + (rough - 0.1) / 0.1;
    else if (rough <= 0.55) l = 4.0 + (rough - 0.4) / 0.15;
    else if (rough <= 0.75) l = 5.0 + (rough - 0.55) / 0.2;
    else l = 6.0 + (rough - 0.75) / 0.25;
    l = clamp(l, 0.0, 7.0);
    float l0 = floor(l);
    vec2 uv = vec2(atan(d.x, -d.z) * (0.5 / PI) + 0.5, acos(clamp(d.y, -1.0, 1.0)) / PI);
    return mix(envLevel(uv, l0), envLevel(uv, min(l0 + 1.0, 7.0)), l - l0);
}

float D_GGX(float a, float nh)
{
    float a2 = a * a;
    float d = nh * nh * (a2 - 1.0) + 1.0;
    return a2 / (PI * d * d);
}

float V_Smith(float a, float nl, float nv)
{
    float a2 = a * a;
    float gv = nl * sqrt(a2 + (1.0 - a2) * nv * nv);
    float gl = nv * sqrt(a2 + (1.0 - a2) * nl * nl);
    return 0.5 / max(gv + gl, 1e-5);
}

vec3 F_Schlick(vec3 f0, float vh)
{
    float f = exp2((-5.55473 * vh - 6.98316) * vh);
    return f0 * (1.0 - f) + f;
}

vec3 specular(vec3 n, vec3 v, vec3 l, vec3 f0, float rough)
{
    vec3 h = normalize(l + v);
    float nl = clamp(dot(n, l), 0.0, 1.0);
    float nv = clamp(dot(n, v), 1e-3, 1.0);
    float nh = clamp(dot(n, h), 0.0, 1.0);
    float vh = clamp(dot(v, h), 0.0, 1.0);
    float a = rough * rough;
    return F_Schlick(f0, vh) * (V_Smith(a, nl, nv) * D_GGX(a, nh));
}

vec3 directLight(vec3 n, vec3 v, vec3 l, vec3 color, vec3 diffuse, vec3 f0, float rough)
{
    float nl = clamp(dot(n, l), 0.0, 1.0);
    if (nl <= 0.0) return vec3(0.0);
    return color * nl * (diffuse / PI + specular(n, v, l, f0, rough));
}

// Three's DFG approximation (EnvironmentBRDF).
vec2 dfg(float rough, float nv)
{
    vec4 rr = rough * vec4(-1.0, -0.0275, -0.572, 0.022) + vec4(1.0, 0.0425, 1.04, -0.04);
    float a004 = min(rr.x * rr.x, exp2(-9.28 * nv)) * rr.x + rr.y;
    return vec2(-1.04, 1.04) * a004 + rr.zw;
}

void main()
{
    vec4 albedo = BaseColor;
    if (Flags.x > 0.5)
    {
        vec4 t = texture2D(Albedo, v_uv);
        if (CardParams.x > 0.001) t = mix(t, texture2D(CardArt, v_uv), CardParams.x);
        t.rgb = srgbToLinear(t.rgb);
        albedo *= t;
    }
    vec3 v = normalize(CameraPos - v_world);
    vec3 n = normalize(v_normal);
    // Flat shading (the faceted jewel): face normal from screen derivatives.
    if (CardParams2.y > 0.5) n = normalize(cross(dFdx(v_world), dFdy(v_world)));
    if (dot(n, v) < 0.0 && (Flags.y > 0.5 || CardParams2.y > 0.5)) n = -n;
    float rough = clamp(MatParams.x, 0.0525, 1.0);
    float metal = MatParams.y;
    vec3 diffuse = albedo.rgb * (1.0 - metal);
    vec3 f0 = mix(vec3(0.04), albedo.rgb, metal);

    vec3 col = directLight(n, v, normalize(KeyDir), KeyColor, diffuse, f0, rough);
    col += directLight(n, v, normalize(RimDir), RimColor, diffuse, f0, rough);
    col += Ambient * diffuse;
    float nv = clamp(dot(n, v), 0.0, 1.0);
    vec3 irradiance = envAt(n, 1.0) * EnvIntensity;
    vec3 r = normalize(mix(reflect(-v, n), n, rough * rough));
    vec3 radiance = envAt(r, rough) * EnvIntensity;
    vec2 fab = dfg(rough, nv);
    vec3 fssEss = f0 * fab.x + fab.y;
    float ems = 1.0 - (fab.x + fab.y);
    vec3 favg = f0 + (1.0 - f0) * 0.047619;
    vec3 fms = fssEss * favg / (1.0 - ems * favg);
    vec3 multi = fms * ems;
    vec3 total = fssEss + multi;
    col += radiance * fssEss + multi * irradiance;
    col += diffuse * (1.0 - max(max(total.r, total.g), total.b)) * irradiance;
    col += EmissiveColor;

    // Clearcoat layer (MeshPhysicalMaterial): an extra dielectric lobe over the base.
    float cc = CardParams.w;
    if (cc > 0.0)
    {
        float ccr = clamp(CardParams2.x, 0.0525, 1.0);
        vec3 ccSpec = vec3(0.0);
        vec3 lk = normalize(KeyDir);
        vec3 lr = normalize(RimDir);
        ccSpec += KeyColor * clamp(dot(n, lk), 0.0, 1.0) * specular(n, v, lk, vec3(0.04), ccr);
        ccSpec += RimColor * clamp(dot(n, lr), 0.0, 1.0) * specular(n, v, lr, vec3(0.04), ccr);
        vec2 cfab = dfg(ccr, nv);
        ccSpec += envAt(reflect(-v, n), ccr) * EnvIntensity * (0.04 * cfab.x + cfab.y);
        float fcc = F_Schlick(vec3(0.04), nv).x;
        col = col * (1.0 - cc * fcc) + ccSpec * cc;
    }

    col = linearToSrgb(aces(col));
    // Shine band sweeping across the face (added after tone mapping, like the web build).
    if (CardParams.y > 0.0)
    {
        float sd = dot(v_uv - 0.5, normalize(vec2(1.0, 0.55))) - CardParams.z;
        col += vec3(1.0, 0.94, 0.8) * CardParams.y * (smoothstep(0.09, 0.0, abs(sd)) * 0.55 + smoothstep(0.02, 0.0, abs(sd)) * 0.5);
    }
    gl_FragColor = vec4(col, albedo.a);
}
